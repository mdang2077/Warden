{
  "name": "@warden/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "wxt prepare && tsc -p tsconfig.json",
    "build:e2e": "WXT_FEED_SERVICE_URL=http://127.0.0.1:47123 wxt build --mode e2e",
    "e2e": "WXT_FEED_SERVICE_URL=http://127.0.0.1:47123 wxt build --mode e2e && playwright test"
  },
  "dependencies": {
    "@warden/shared": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.4",
    "fake-indexeddb": "^6.2.5",
    "wxt": "^0.21.4"
  }
}
