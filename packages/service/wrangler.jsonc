{
  // Warden feed service. Deploying needs a Cloudflare account: `wrangler login`, create the
  // R2 bucket, set the SB_API_KEY secret, then `wrangler deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "warden-feeds",
  "main": "src/runners/worker.ts",
  "compatibility_date": "2026-10-01",
  "triggers": {
    // Hourly ingest + publish. OpenPhish refreshes every 12 h; ETags make most polls cheap.
    "crons": ["17 * * * *"]
  },
  "r2_buckets": [{ "binding": "FEEDS", "bucket_name": "warden-feeds" }],
  "ratelimits": [
    {
      // Per-IP limit for the Safe Browsing proxy.
      "name": "SB_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      // Overall cap on calls to Google (cache misses only), so a traffic spike can't burn the
      // Safe Browsing quota. Per Cloudflare location, so approximate. Set it to the project's
      // daily quota / 1440 once the quota is known (Google Cloud Console). Over the cap, the
      // proxy answers 503 and extensions fail open with "protection reduced".
      "name": "SB_UPSTREAM_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ]
  // Secrets (wrangler secret put): SB_API_KEY, ADMIN_TOKEN, MANIFEST_SIGNING_KEY,
  // MANIFEST_KEY_ID. Optional var: ALERT_WEBHOOK_URL.
}
